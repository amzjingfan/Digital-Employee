# Platform administrators manage every enterprise resource in their validated tenant.
p, tenant_admin, *, /api/enterprise/*, (GET|POST|PUT|PATCH|DELETE), allow

# Backward-compatible local members can inspect resources and operate their collaboration records.
p, tenant_member, *, /api/enterprise/*, GET, allow
p, tenant_member, *, /api/enterprise/teams, POST, allow
p, tenant_member, *, /api/enterprise/teams/*, (POST|PUT|PATCH|DELETE), allow
p, tenant_member, *, /api/enterprise/team-threads/*, (POST|PUT|PATCH|DELETE), allow
p, tenant_member, *, /api/enterprise/scheduled-tasks, POST, allow
p, tenant_member, *, /api/enterprise/scheduled-tasks/*, (POST|PUT|PATCH|DELETE), allow
p, tenant_member, *, /api/enterprise/sessions/*, (POST|PUT|PATCH|DELETE), allow
p, tenant_member, *, /api/enterprise/feedback/*, (POST|PUT|PATCH|DELETE), allow
p, tenant_member, *, /api/enterprise/memories/*, (POST|PUT|PATCH|DELETE), allow
p, tenant_member, *, /api/enterprise/authorization-decisions, GET, deny
p, tenant_member, *, /api/enterprise/authorization-decisions/*, GET, deny
p, tenant_member, *, /api/enterprise/identity-role-mappings, GET, deny

# Operations supervisors review all operational resources and coordinate work, but cannot
# change platform identity, model, channel, tool, or knowledge configuration.
p, operations_supervisor, *, /api/enterprise/*, GET, allow
p, operations_supervisor, *, /api/enterprise/teams, POST, allow
p, operations_supervisor, *, /api/enterprise/teams/*, (POST|PUT|PATCH|DELETE), allow
p, operations_supervisor, *, /api/enterprise/team-threads/*, (POST|PUT|PATCH|DELETE), allow
p, operations_supervisor, *, /api/enterprise/scheduled-tasks, POST, allow
p, operations_supervisor, *, /api/enterprise/scheduled-tasks/*, (POST|PUT|PATCH|DELETE), allow
p, operations_supervisor, *, /api/enterprise/sessions/*, (POST|PUT|PATCH|DELETE), allow
p, operations_supervisor, *, /api/enterprise/feedback/*, (POST|PUT|PATCH|DELETE), allow
p, operations_supervisor, *, /api/enterprise/memories/*, (POST|PUT|PATCH|DELETE), allow
p, operations_supervisor, *, /api/enterprise/authorization-decisions, GET, deny
p, operations_supervisor, *, /api/enterprise/authorization-decisions/*, GET, deny
p, operations_supervisor, *, /api/enterprise/identity-role-mappings, GET, deny

